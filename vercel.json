{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/__auth/callback", "destination": "/__auth/callback.html" }
  ],
  "functions": {
    "api/auth/callback.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
