# Vercel Serverless Function env (required):
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# GITHUB_SESSION_SECRET=use-a-long-random-secret
# GITHUB_ALLOWED_LOGINS=kongjianguan

# Set to 1 to skip GitHub OAuth login in local development
# The editor UI will show as logged-in, drafts work, but GitHub API needs a real token
VITE_LOCALEDIT=1
