{
  "name": "kongjianguan",
  "version": "1.0.0",
  "description": "Personal blog built with VitePress",
  "homepage": "https://github.com/kongjianguan/VitePressBlog",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "NODE_OPTIONS=--max-old-space-size=5120 vitepress build docs",
    "preview": "vitepress preview docs",
    "test": "pnpm --filter @kongjianguan/markdown-editor test",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.scratch/playwright-browsers playwright test",
    "typecheck": "pnpm --filter @kongjianguan/markdown-editor typecheck",
    "validate:api": "node scripts/validate-api-sources.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@kongjianguan/markdown-editor": "workspace:*",
    "echarts": "^6.1.0",
    "markdown-it": "^14.3.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.16.0",
    "oh-my-live2d": "^0.19.3",
    "pagefind": "^1.5.2",
    "sass": "^1.101.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-image-preview": "^0.1.4",
    "vitepress-plugin-legend": "^1.4.2",
    "vitepress-plugin-pagefind": "^0.4.22",
    "vitepress-theme-teek": "^1.6.0",
    "vue": "^3.5.39",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
